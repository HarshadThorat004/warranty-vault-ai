# App
DATABASE_URL=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Email (OTP + warranty reminders) via Resend free tier
# 1) Create API key at https://resend.com
# 2) Verify domain warrantyvault.in (SPF/DKIM) at https://resend.com/domains
# 3) From can be any address on that domain — no mailbox creation required
RESEND_API_KEY=
RESEND_FROM_EMAIL=Warranty Vault <noreply@warrantyvault.in>
RESEND_REPLY_TO=warrantyvault.in@gmail.com
RESEND_TEST_RECIPIENT=warrantyvault.in@gmail.com
# Optional buffer under Resend free 100/day cap (default 95)
RESEND_DAILY_LIMIT=95
CRON_SECRET=

# Free Google Sign-In
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — legacy vision OCR (disabled by default; hybrid scan is built-in)
GEMINI_API_KEY=
# OCR_USE_GEMINI=true
UPLOADTHING_TOKEN=
