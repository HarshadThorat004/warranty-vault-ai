generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String             @unique
  password          String?
  image             String?
  createdAt         DateTime           @default(now())
  products          Product[]
  notificationLogs  NotificationLog[]
  emailOtps         EmailOtp[]
  pushSubscriptions PushSubscription[]
  householdMembership HouseholdMember?
  householdInvitesSent HouseholdInvite[]
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, expiresAt])
  @@index([email])
}

model Product {
  id                 String             @id @default(cuid())
  name               String
  brand              String?
  model              String?
  category           String?
  retailer           String?
  serialNumber       String?
  invoiceNumber      String?
  purchaseAmount     String?
  purchaseDate       DateTime?
  warrantyExpiry     DateTime?
  extendedExpiry     DateTime?
  extendedType       String?
  invoiceImage       String?
  notes              String?
  renewalAvailable   Boolean            @default(false)
  renewalNotes       String?
  createdAt          DateTime           @default(now())
  userId             String
  householdId        String?
  documents          Document[]
  notificationLogs   NotificationLog[]
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  household          Household?         @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([householdId])
  @@index([warrantyExpiry])
  @@index([userId, warrantyExpiry])
}

model Household {
  id        String             @id @default(cuid())
  name      String             @default("Family vault")
  createdAt DateTime           @default(now())
  members   HouseholdMember[]
  invites   HouseholdInvite[]
  products  Product[]
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  userId      String    @unique
  role        String
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([householdId])
}

model HouseholdInvite {
  id           String    @id @default(cuid())
  householdId  String
  email        String
  token        String    @unique
  invitedById  String
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy    User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([householdId])
}

model Document {
  id           String   @id @default(cuid())
  fileUrl      String
  fileType     String
  uploadedAt   DateTime @default(now())
  productId    String
  documentType String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model NotificationLog {
  id        String    @id @default(cuid())
  userId    String
  productId String
  type      String
  channel   String
  periodKey String
  sentAt      DateTime  @default(now())
  readAt      DateTime?
  dismissedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, channel, sentAt])
  @@unique([userId, productId, type, channel, periodKey])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
